# Copy to `.env` and fill in. `.env` is git-ignored.

# --- قاعدة البيانات ---------------------------------------------------------
# مطلوب. سلاسل الاتصال التي لا تحمل اسم قاعدة بيانات تسجّل البيانات في قاعدة
# مونجو الافتراضية "test"؛ أضف اسمًا إلى الرابط إن أردت قاعدة مخصّصة.
# للتشغيل والاختبار معًا، تُنشئ اختبارات التكامل قاعدة بيانات مؤقتة وتحذفها.
MONGODB_URI=mongodb://127.0.0.1:27017/jradil

# اختياري: يثبّت اسم قاعدة البيانات متجاوزًا ما في الرابط.
# MONGODB_DB=jradil

# --- رابط التطبيق -----------------------------------------------------------
# يظهر في نص «شارك نتيجتك». ضع الرابط الكامل مع البروتوكول، مثل
# https://jradil.example.com — وإن تُرك فارغًا يُحذف السطر من نص المشاركة.
APP_URL=http://localhost:3000

# --- التنبيهات اليومية --------------------------------------------------------
# مفاتيح VAPID لتوقيع إشعارات المتصفح. لكل نشر مفاتيحه الخاصة:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# تغييرها يُبطل كل الاشتراكات القائمة، فيُعاد الاشتراك من جديد.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# جهة الاتصال المسؤولة عن الإشعارات، وهي شرط في بروتوكول Web Push.
VAPID_SUBJECT=mailto:you@example.com

# --- مجدول خارجي (اختياري) ---------------------------------------------------
# التطبيق يرسل تنبيه كلمة اليوم بنفسه كل يوم. عند ضبط هذا، تقبل النقطة
# /api/cron/reminder قيمة ?secret= أو ترويسة x-cron-secret بدلًا من جلسة مشرف.
# CRON_SECRET=

# --- لوحة المشرف ------------------------------------------------------------
# مطلوب لتفعيل /admin. اختر كلمة مرور قوية.
ADMIN_PASSWORD=change-me

# اختياري: سرّ إضافي يدخل في توقيع كوكي الجلسة مع كلمة المرور. تغييره، أو تغيير
# كلمة المرور، يُنهي كل الجلسات القائمة.
# ADMIN_SESSION_SECRET=

# اختياري: اضبطه على true فقط إن كان التطبيق خلف وكيل عكسي (reverse proxy) يضيف
# ترويسة X-Forwarded-For، ليُحسب حدّ محاولات الدخول لكل عنوان IP حقيقي بدل عنوان
# الوكيل. لا تفعّله دون وكيل، وإلا استطاع أي زائر تزوير عنوانه.
# TRUST_PROXY=true
